{
  "minComponentTokenCoverage": 90,
  "maxUnusedTokenRatio": 0.5,
  "impeccableMinScore": 95,
  "failOnHardcodedValues": true,
  "runImpeccable": true,
  "includePaths": ["components/**/*.tsx", "app/**/*.tsx", "lib/**/*.ts"],
  "componentPaths": ["components/**/*.tsx", "app/**/*.tsx"],
  "excludePaths": [
    "**/*.stories.tsx",
    "**/*.test.tsx",
    "**/tokens/**",
    "**/build/**",
    "**/*.d.ts",
    "lib/brevo.ts"
  ],
  "allowedHardcoded": [
    "transparent",
    "currentColor",
    "inherit",
    "initial",
    "unset",
    "#4285F4",
    "#34A853",
    "#FBBC05",
    "#EA4335"
  ],
  "tokenPaths": [
    "tokens/**/*.json",
    "src/lib/design-tokens.ts",
    "src/styles/tokens.css",
    "src/styles/globals.css"
  ]
}
