# =============================================================================
# Zero-Risk SaaS Stack - Environment Variables Template
# Stack: Next.js 14 + Supabase + Cloudflare Pages + Stripe + Brevo
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# APP CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# The public URL of your deployed application
# Required for: OAuth redirects, email links, Stripe webhooks, CORS
APP_URL=https://your-app.pages.dev

# Display name for your app (used in emails, UI, metadata)
APP_NAME=YourApp

# -----------------------------------------------------------------------------
# SUPABASE (Required - all three)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Free tier: 500MB database, 2GB bandwidth, 50K MAU Auth
# -----------------------------------------------------------------------------
# Project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public anon key - safe to expose client-side
# Used for: client-side auth, database queries from browser
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key - NEVER expose client-side!
# Used for: server-side admin operations, webhooks, cron jobs
# Keep this secret - full database access bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# STRIPE (Required for billing)
# Get these from: https://dashboard.stripe.com/apikeys
# Test mode keys start with sk_test_ / pk_test_
# Free tier: No monthly fee, 2.9% + 30¢ per successful charge
# -----------------------------------------------------------------------------
# Secret key - server-side only! Never expose to client
STRIPE_SECRET_KEY=sk_test_...

# Publishable key - safe for client-side
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret - get from Stripe CLI or Dashboard
# Required for: verifying webhook events (checkout, subscription, invoice)
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# STRIPE PRICES (Optional - for subscription plans)
# Create prices in Stripe Dashboard → Products → Pricing
# Format: price_XXXXXXXXXXXXXX
# Free tier: Unlimited prices/products
# -----------------------------------------------------------------------------
# Monthly Pro plan price ID
# STRIPE_PRICE_MONTHLY_PRO=price_...

# Yearly Pro plan price ID (typically ~20% discount)
# STRIPE_PRICE_YEARLY_PRO=price_...

# Monthly Team plan price ID (per seat)
# STRIPE_PRICE_MONTHLY_TEAM=price_...

# Yearly Team plan price ID (per seat)
# STRIPE_PRICE_YEARLY_TEAM=price_...

# -----------------------------------------------------------------------------
# BREVO / SENDINBLUE (Optional - for transactional emails beyond Supabase Auth)
# Get API key from: https://app.brevo.com/settings/keys
# Free tier: 300 emails/day, unlimited contacts
# Use this if you need: marketing emails, advanced templates, dedicated IP
# Supabase Auth already sends: magic links, password reset, email confirmation
# -----------------------------------------------------------------------------
# BREVO_API_KEY=xkeysib-...

# -----------------------------------------------------------------------------
# CLOUDFLARE (Required for Workers/Pages deployment)
# Get Account ID from: https://dash.cloudflare.com/ (right sidebar)
# Create API Token at: https://dash.cloudflare.com/profile/api-tokens
# Token permissions: Account > Workers Scripts > Edit, Account > Pages > Edit
# Free tier: 100K requests/day Workers, unlimited Pages requests, 500 builds/month
# -----------------------------------------------------------------------------
# Account ID (32-char hex string)
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Token with Workers/Pages edit permissions
CLOUDFLARE_API_TOKEN=...

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional - toggle features without code changes)
# Set to "true" to enable, "false" or omit to disable
# -----------------------------------------------------------------------------
# Enable Stripe billing/subscriptions
ENABLE_BILLING=true

# Enable team/workspace functionality
ENABLE_TEAMS=false

# Enable analytics tracking (Plausible, PostHog, etc.)
ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS / MONITORING (Add as needed)
# -----------------------------------------------------------------------------
# Plausible: PLAUSIBLE_DOMAIN=your-app.pages.dev
# PostHog: NEXT_PUBLIC_POSTHOG_KEY=phc_... NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# LogRocket: LOG_ROCKET_APP_ID=...

# -----------------------------------------------------------------------------
# SENTRY (Error monitoring - le "zéro bug" en prod, voir skill ns-sentry)
# Capture les erreurs de production : trier par coût (occurrences × users), jamais par date
# -----------------------------------------------------------------------------
# Get DSN from: https://sentry.io/settings/projects/<project>/keys/
# Vend: SENTRY_DSN=https://<key>@sentry.io/<project>

SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL: ADDITIONAL INTEGRATIONS
# -----------------------------------------------------------------------------
# GitHub OAuth (for team invites, repo access)
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Google OAuth
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Discord OAuth
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...