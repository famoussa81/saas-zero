echo "🔍 Vérifications avant commit..."

# Formatage + lint sur les seuls fichiers indexés
npx lint-staged || exit 1

# Typecheck complet : rapide, et c'est le filet qui attrape les régressions de
# types qu'un lint sur fichiers isolés ne peut pas voir.
npx tsc --noEmit --skipLibCheck || {
  echo "❌ Typecheck en échec. Commit bloqué."
  exit 1
}

echo "✅ Pré-commit passé"
