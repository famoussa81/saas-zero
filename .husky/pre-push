echo "🔒 Quality gates avant push..."

# Passe par le runner unique : même logique PASS/FAIL/SKIP qu'en CI et en local,
# une seule source de vérité. Sélection volontairement rapide — un pre-push qui
# dure cinq minutes finit contourné avec --no-verify.
#
# Historique : ce hook appelait `npx next lint`, commande SUPPRIMÉE dans
# Next.js 16 (le projet est en 16.3.0). Next interprétait alors "lint" comme un
# chemin de projet et échouait sur
#   Invalid project directory provided, no such directory: <repo>/lint
# — tout push était bloqué pour une raison sans rapport avec le code.
node .claude/scripts/run-gates.js typecheck lint || {
  echo "❌ Gates en échec. Push bloqué."
  echo "   Corriger, ou contourner en connaissance de cause avec --no-verify."
  exit 1
}
