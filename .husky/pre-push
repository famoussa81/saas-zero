#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# FULL QUALITY GATES - BLOCKS PUSH ON FAILURE
echo "🔒 Running pre-push gates..."

# 1. Typecheck + lint (fast, fail-closed)
if ! npx tsc --noEmit --skipLibCheck; then
  echo "❌ Typecheck failed. Push blocked."
  exit 1
fi

if ! npx next lint; then
  echo "❌ Lint failed. Push blocked."
  exit 1
fi

echo "✅ All pre-push checks passed. Pushing..."
