{
  "name": "saas-zero",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm content:watch\" \"pnpm next:dev\"",
    "next:dev": "next dev",
    "build": "pnpm content:build && next build && pnpm pagefind",
    "build:analyze": "ANALYZE=true pnpm content:build && next build && pnpm pagefind",
    "content:build": "content-collections build",
    "content:watch": "content-collections watch",
    "pagefind": "pagefind --site .next/server/app",
    "search:dev": "pagefind --site .next/server/app --port 8788",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_TOKEN",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint:fix": "next lint --fix",
    "postinstall": "playwright install --with-deps",
    "prepare": "husky install",
    "supabase:gen:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "supabase:start": "supabase start",
    "supabase:migrate:up": "supabase db push",
    "wrangler:dev": "wrangler dev",
    "deploy:preview": "wrangler pages deploy --project-name=saas-zero --branch=preview",
    "gates:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "gate:typecheck": "pnpm typecheck",
    "gate:lint": "pnpm lint",
    "gate:test": "pnpm test",
    "gate:e2e": "pnpm test:e2e",
    "gate:visual": "pnpm test:visual",
    "gate:lighthouse": "npx lhci autorun",
    "gate:bundle": "cross-env ANALYZE=true pnpm build",
    "gate:cwv": "npx lhci autorun --config=lighthouse-ci.json",
    "gate:hydration": "pnpm build 2>&1 | grep -i 'hydration\\|mismatch' || echo 'No hydration mismatches'",
    "gate:rls": "supabase test db",
    "gate:security": "npm audit --audit-level=high && npx codeql database analyze --format=sarif-latest --output=codeql-results.sarif codeql-db 2>/dev/null || echo 'CodeQL not configured, skipping'",
    "gate:accessibility": "npx playwright test --config=playwright.a11y.config.ts",
    "gate:load": "k6 run tests/load/scenario.js 2>/dev/null || echo 'k6 not installed, skipping load test'",
    "gate:sentry": "node -e \"const e=process.env; ['SENTRY_DSN'].forEach(k=>{if(!e[k]){console.warn('SENTRY_DSN not set, skipping');process.exit(0)}}); console.log('SENTRY_DSN configured')\"",
    "gate:contracts": "echo 'Contract tests not yet implemented' && exit 0",
    "env:check": "node -e \"require('dotenv').config({path:'.env.local'}); ['SUPABASE_URL','SUPABASE_ANON_KEY','STRIPE_SECRET_KEY','STRIPE_PUBLISHABLE_KEY','BREVO_API_KEY'].forEach(k=>{if(!process.env[k]){console.error('Missing:',k);process.exit(1)}}); console.log('All required env vars present')\""
  },
  "dependencies": {
    "@content-collections/core": "^0.7.0",
    "@content-collections/mdx": "^0.2.2",
    "@gsap/react": "^2.1.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-form": "^0.0.3",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.15.0",
    "@sendinblue/client": "^3.3.1",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.1",
    "date-fns": "^3.3.1",
    "embla-carousel-react": "^8.0.0",
    "gsap": "^3.12.5",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.363.0",
    "motion": "^10.17.0",
    "next": "14.2.0",
    "next-auth": "^5.0.0-beta.15",
    "next-intl": "^3.11.0",
    "next-mdx-remote": "^5.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.2.1",
    "pagefind": "^1.1.0",
    "plausible-tracker": "^0.3.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "recharts": "^2.12.0",
    "sonner": "^1.4.0",
    "stripe": "^14.0.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^1.0.0",
    "@commitlint/config-conventional": "^19.0.3",
    "@content-collections/cli": "^0.1.9",
    "@next/bundle-analyzer": "^14.2.0",
    "@playwright/test": "^1.44.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "@types/pngjs": "^6.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^1.4.0",
    "@vitest/ui": "^1.4.0",
    "autoprefixer": "^10.4.19",
    "commitlint": "^19.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "next-sitemap": "^4.2.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "storybook-addon-paddings": "^1.0.0",
    "storybook-addon-pseudo-states": "^1.0.0",
    "supabase": "^1.150.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "wrangler": "^3.40.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "pixelmatch",
      "pngjs",
      "esbuild"
    ]
  }
}
