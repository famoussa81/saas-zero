{
  "name": "saas-zero",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm content:watch\" \"pnpm next:dev\"",
    "next:dev": "next dev",
    "next:start": "next start",
    "build": "pnpm content:build && next build && pnpm pagefind",
    "build:analyze": "ANALYZE=true pnpm content:build && next build && pnpm pagefind",
    "content:build": "content-collections build",
    "content:watch": "content-collections watch",
    "pagefind": "pagefind --site .next/server/app",
    "search:dev": "pagefind --site .next/server/app --port 8788",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_TOKEN",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "postinstall": "playwright install --with-deps",
    "prepare": "husky install",
    "supabase:gen:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "supabase:start": "supabase start",
    "supabase:migrate:up": "supabase db push",
    "discovery:check": "node .claude/scripts/discovery-check.js",
    "gates:all": "node .claude/scripts/run-gates.js",
    "gate:typecheck": "pnpm typecheck",
    "gate:lint": "pnpm lint",
    "gate:test": "pnpm test",
    "gate:e2e": "pnpm test:e2e",
    "gate:visual": "pnpm test:visual",
    "gate:lighthouse": "pnpm exec lhci autorun",
    "gate:bundle": "node .claude/scripts/check-bundle-budget.js",
    "gate:cwv": "pnpm exec lhci autorun --config=lighthouse-ci.json",
    "gate:hydration": "node .claude/scripts/check-hydration.js",
    "gate:rls": "pnpm exec supabase test db",
    "gate:security": "node .claude/scripts/check-security.js",
    "gate:accessibility": "pnpm exec playwright test --config=playwright.a11y.config.ts",
    "gate:load": "node .claude/scripts/run-load-test.js",
    "gate:contracts": "pnpm exec vitest run tests/contracts",
    "gate:design": "pnpm design:check",
    "design:tokens:build": "style-dictionary build --config style-dictionary.config.js",
    "design:tokens:watch": "style-dictionary build --config style-dictionary.config.js --watch",
    "design:tokens:audit": "node .claude/scripts/design-tokens-audit.js",
    "design:inventory": "node .claude/scripts/design-inventory.js",
    "design:check": "node .claude/scripts/design-check.js",
    "media:fetch": "node .claude/scripts/media-fetcher.js",
    "env:check": "node .claude/scripts/env-check.js",
    "build-storybook": "storybook build",
    "gates:fast": "node .claude/scripts/run-gates.js --fast",
    "gates:list": "node .claude/scripts/run-gates.js --list",
    "gates:strict": "node .claude/scripts/run-gates.js --strict",
    "ns:new": "node .claude/scripts/new-project.js",
    "doctor": "node .claude/scripts/doctor.js",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:contract": "vitest run tests/contracts",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "deps:check": "pnpm outdated",
    "verify:ci": "node .claude/scripts/run-gates.js --strict",
    "adr:new": "node .claude/scripts/new-adr.js",
    "format:check": "prettier --check .",
    "bundlesize": "node .claude/scripts/check-bundle-budget.js",
    "deploy:preview": "vercel --prebuilt",
    "design:tokens:check": "node .claude/scripts/design-tokens-audit.js"
  },
  "dependencies": {
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@getbrevo/brevo": "^6.0.2",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.29.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "next-mdx-remote": "^6.0.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@content-collections/cli": "^0.1.9",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "commitlint": "^21.2.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "k6": "^0.0.0",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "pixelmatch": "^7.2.0",
    "playwright": "latest",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.7",
    "storybook-addon-pseudo-states": "^10.5.7",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "latest",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "tmp": ">=0.2.6"
    }
  }
}
