{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/app/*": ["./app/*"],
      "@/styles/*": ["./src/styles/*"]
    },
    "baseUrl": ".",
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom",
      "next",
      "next/image-types/global"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".content-collections/**/*.ts",
    ".next/types/**/*.ts",
    "tests/**/*",
    "supabase/functions/**/*"
  ],
  "exclude": ["node_modules"]
}
